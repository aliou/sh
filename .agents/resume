#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

if [[ "$(node --version)" != v24.* ]]; then
	echo "Node.js 24 is unavailable; rerun .agents/setup" >&2
	exit 1
fi

if [[ "$(pnpm --version)" != "10.26.1" ]]; then
	echo "pnpm 10.26.1 is unavailable; rerun .agents/setup" >&2
	exit 1
fi

echo "Orb resumed: Node.js $(node --version), pnpm $(pnpm --version)"
